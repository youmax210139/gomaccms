# 复制为 .env 后按需修改:  cp .env.example .env

# nginx 对外暴露的网站端口 (前台 /index, 后台 /login)
APP_PORT=80

# MySQL root 密码 (首次启动时初始化, 之后修改需同步修改数据库)
MYSQL_ROOT_PASSWORD=change-me-mysql

# Redis 访问密码
REDIS_PASSWORD=change-me-redis

# Redis 最大内存
REDIS_MAXMEMORY=1gb

# ---------- SEO 发布中心 (可选, 未设置时使用默认值) ----------
# 每个 sitemap 分片最多的 URL 数; 内容变动后自动重建 sitemap 的间隔 (分钟, 0 为不自动重建)
# SITEMAP_CHUNK_SIZE=50000
# SITEMAP_AUTO_INTERVAL=60
# /rss.xml 的影片数与缓存秒数
# RSS_LIMIT=50
# RSS_CACHE_TTL=300
# IndexNow: 启用后内容变动的影片 URL 按分类方案推送到该方案网站开启的域名 (验证文件为 /<INDEXNOW_KEY>.txt);
# INDEXNOW_HOST 为默认分类方案在「未配置的域名」上的推送域名
# INDEXNOW_ENABLED=false
# INDEXNOW_KEY=
# INDEXNOW_HOST=www.example.com
# INDEXNOW_BATCH_SIZE=10000
